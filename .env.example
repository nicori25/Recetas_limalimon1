# Sin overrides se usa el proyecto público incluido en src/lib/supabase.public.ts.
# Copiá este archivo a .env.local con ambos valores vacíos para usar la demo.
# Para otro proyecto, completá ambas variables con su URL y clave pública.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# También se admite VITE_SUPABASE_ANON_KEY para proyectos con la clave anon anterior.
# NUNCA colocar service_role ni claves secretas en variables VITE_.
