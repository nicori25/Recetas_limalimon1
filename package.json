{
  "name": "limalimon",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "migrate:legacy": "node scripts/import-legacy.mjs",
    "test:db": "bash scripts/test-db.sh",
    "format": "prettier --write src tests scripts/*.mjs *.ts *.json *.md docs/*.md .github/workflows/ci.yml",
    "format:check": "prettier --check src tests scripts/*.mjs *.ts *.json *.md docs/*.md .github/workflows/ci.yml",
    "build:pages": "vue-tsc -b && vite build --base=/Recetas_limalimon1/",
    "test:pages": "playwright test --config=playwright.pages.config.ts",
    "preview:pages": "vite preview --host 0.0.0.0 --base=/Recetas_limalimon1/"
  },
  "dependencies": {
    "@lucide/vue": "^1.70.0",
    "@supabase/supabase-js": "^2.99.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.30",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.2.5"
  }
}
